# ── intervals.icu API credentials ────────────────────────────────────────────
# API key:    https://intervals.icu/settings  (My Account → API Key)
# Athlete ID: visible in the URL, e.g. https://intervals.icu/athlete/iXXXXXX
ICU_API_KEY=your_api_key_here
ICU_ATHLETE_ID=iXXXXXX

# ── Remote HTTP server (mcp_http_server.py) ──────────────────────────────────
# Only needed when hosting the server for claude.ai. The local stdio server
# (mcp_server.py) ignores everything below.

# Shared secret that forms the URL path: https://<host>/<MCP_SECRET>/mcp
# Must be at least 24 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET=

# The public domain the reverse proxy serves. Requests arriving with any other
# Host header are rejected, which is what blocks DNS-rebinding attacks.
MCP_PUBLIC_HOST=coach.example.com

# Optional: extra origins allowed to call the server, comma-separated.
# claude.ai and MCP_PUBLIC_HOST are always allowed. Exact matches only.
# MCP_ALLOWED_ORIGINS=https://claude.com
